::keys [".0%", "10", "2", "3", "6", "8", "COEFF_FLOOR", "OVERLAP_LINES", "OVERLAP_MIN", "SHARED_STRONG", "SHARED_WEAK", "Unit", "_distinctive_shared", "append", "bool", "dict", "end", "exact_structural_dup", "feats", "file", "fp", "identical fingerprint (a rename of the same code)", "len", "lines", "matching normalized lines", "min", "of the smaller unit's features", "overlap", "overlap_blocks", "overlap_coeff", "overlap_lines", "path", "qualname", "reasons", "round", "shared", "shared distinctive tokens", "shared distinctive tokens covering", "shared_count", "span", "start", "sum", "unit"]
