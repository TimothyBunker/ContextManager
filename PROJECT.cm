::doc Deterministic discrete features: the tokens a unit cannot hide.
::imports __future__, ast, builtins, normalize, re
::unit function _keep_literal @54-62 #ebb77afc
::sig _keep_literal(v) -> str | None
::keys ["2", "_LIT_MIN_LEN", "abs", "bool", "float", "int", "isinstance", "len", "repr", "str", "strip"]
::unit function py_module_consts @67-86 #f33ff695
