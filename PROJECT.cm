::keys ["(?:.*/)?", "*.7z", "*.bin", "*.cm", "*.dll", "*.dylib", "*.egg-info/", "*.eot", "*.exe", "*.gif", "*.gz", "*.ico", "*.jpeg", "*.jpg", "*.lock", "*.map", "*.min.js", "*.pdf", "*.png", "*.pyc", "*.pyo", "*.so", "*.tar", "*.ttf", "*.woff", "*.woff2", "*.zip", ".DS_Store", ".claude/", ".cm/", ".git/", ".hg/", ".idea/", ".mypy_cache/", ".next/", ".pytest_cache/", ".ruff_cache/", ".svn/", ".tox/", ".venv/", ".vscode/", "DEFAULT_RULES", "Rule", "__pycache__/", "_glob_to_regex", "append", "bool", "build/", "compile", "dist/", "endswith", "list", "lstrip", "node_modules/", "out/", "package-lock.json", "re", "rstrip", "rules", "startswith", "str", "strip", "target/", "venv/"]
